# Database connection
DATABASE_URL=mysql+pymysql://event_booking_user:change_me@localhost:3306/event_booking

# Generate a high-entropy random secret (at least 32 characters).
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_chars

# Optional: comma-separated emails that may register as admin accounts.
# Only configure this on trusted deployments; never accept role from request input.
ADMIN_EMAILS=admin@example.com

FRONTEND_URL=http://localhost:3000
